NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Prefer ANON_KEY on Vercel (legacy anon JWT or publishable key both work as the public client key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alias used during Phase 1 setup
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — never expose to the client / never use in middleware
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (CLI / migrations) — password from Supabase Dashboard
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# OpenAI — server only (never NEXT_PUBLIC_, never commit real values)
# Set in Vercel for Production, Preview, and Development environments.
OPENAI_API_KEY=
