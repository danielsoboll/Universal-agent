NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Prefer ANON_KEY on Vercel (legacy anon JWT or publishable key both work as the public client key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alias used during Phase 1 setup
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — never expose to the client / never use in middleware
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database (CLI / migrations) — password from Supabase Dashboard
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# OpenAI — server only (never NEXT_PUBLIC_, never commit real values)
# Set in Vercel for Production, Preview, and Development environments.
OPENAI_API_KEY=

# Local auth session HMAC (server only). Required for /login cookie signing.
LOCAL_SESSION_SECRET=

# Local SAP data root — absolute path OUTSIDE this git repo.
# Only in .env.local (never hardcode in source). Never copy customer raw data into git.
# Layout: {LOCAL_DATA_ROOT}/{Projekt}/raw|canonical|analyses|embeddings|indexes|logs/
# raw = read-only; writes only under canonical, analyses, embeddings, indexes, logs.
LOCAL_DATA_ROOT=/absolute/path/to/SAP_AI_Exports

# Optional local ask mapping (dev only — never commit real paths):
# LOCAL_ASK_PROJECT_ID=proj_...          # LocalProject.id aus app-config/projects.json
# LOCAL_KNOWLEDGE_DATA_KEY=P01           # Fallback Ordner unter LOCAL_DATA_ROOT, wenn customers.landscape_label leer
